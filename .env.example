# Modèle de configuration. Copiez les valeurs dans Vercel (Settings → Environment Variables)
# et, pour le développement local, dans un fichier .env.local (jamais commité).
# Ne mettez JAMAIS de vraie valeur dans ce fichier.

# ─── Produit 1 : Login Kit public (génération de leads) ────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URI de retour du Login Kit public. À déclarer à l'identique dans TikTok for Developers.
# (les anciennes valeurs /api/auth/callback et /api/tiktok/callback fonctionnent toujours)
TIKTOK_REDIRECT_URI=https://yallahservices.vercel.app/api/tiktok/auth/callback

# ─── Secrets (générer chacun avec : openssl rand -hex 32) ──────────────────────────────
# Chiffre la session des visiteurs et les jetons stockés. 32 caractères minimum, obligatoire en production.
SESSION_SECRET=
# Ouvre l'espace interne : https://<domaine>/connect?key=<ADMIN_SECRET>. 24 caractères minimum.
# Absent ou trop court : l'espace interne est désactivé (404 pour tout le monde).
ADMIN_SECRET=

# ─── Produit 2 : Direct Post interne (facultatif) ──────────────────────────────────────
# Par défaut : mêmes identifiants TikTok que ci-dessus, et URI de retour
# https://<domaine>/api/tiktok/admin/callback (déduite de TIKTOK_REDIRECT_URI).
TIKTOK_ADMIN_CLIENT_KEY=
TIKTOK_ADMIN_CLIENT_SECRET=
TIKTOK_ADMIN_REDIRECT_URI=
# Hôtes supplémentaires, déjà vérifiés chez TikTok, autorisés pour la publication depuis une URL
# (liste séparée par des virgules). Par défaut : uniquement le domaine du site.
TIKTOK_VIDEO_ALLOWED_HOSTS=

# ─── Stockage durable des jetons du compte administrateur ──────────────────────────────
# Ajoutez « Upstash Redis » au projet (Vercel → Storage → Marketplace) : ces variables sont alors
# injectées automatiquement. À renseigner à la main uniquement pour un test local avec une vraie base.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Anciens noms « Vercel KV », également reconnus : KV_REST_API_URL / KV_REST_API_TOKEN

# ─── Divers ────────────────────────────────────────────────────────────────────────────
# Adresse publique (canonique, partages, publication TikTok). Par défaut : le domaine Vercel de production.
NEXT_PUBLIC_SITE_URL=https://yallahservices.vercel.app
