# Modèle de configuration. Copiez les valeurs dans Vercel (Settings → Environment Variables)
# et, pour le développement local, dans un fichier .env.local (jamais commité).
# Ne mettez JAMAIS de vraie valeur dans ce fichier.

# ─── Produit 1 : Login Kit public (génération de leads) ────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URI de retour du Login Kit public. À déclarer à l'identique dans TikTok for Developers.
# (les anciennes valeurs /api/auth/callback et /api/tiktok/callback fonctionnent toujours)
TIKTOK_REDIRECT_URI=https://yallahservices.vercel.app/api/tiktok/auth/callback

# ─── Secrets (générer chacun avec : openssl rand -hex 32) ──────────────────────────────
# Chiffre la session des visiteurs et les jetons stockés. 32 caractères minimum, obligatoire en production.
SESSION_SECRET=
# Ouvre l'espace interne : https://<domaine>/connect?key=<ADMIN_SECRET>. 24 caractères minimum.
# Absent ou trop court : l'espace interne est désactivé (404 pour tout le monde).
ADMIN_SECRET=

# ─── Produit 2 : Direct Post interne (facultatif) ──────────────────────────────────────
# Par défaut : mêmes identifiants TikTok que ci-dessus, et URI de retour
# https://<domaine>/api/tiktok/admin/callback (déduite de TIKTOK_REDIRECT_URI).
TIKTOK_ADMIN_CLIENT_KEY=
TIKTOK_ADMIN_CLIENT_SECRET=
TIKTOK_ADMIN_REDIRECT_URI=
# Hôtes supplémentaires, déjà vérifiés chez TikTok, autorisés pour la publication depuis une URL
# (liste séparée par des virgules). Par défaut : uniquement le domaine du site.
TIKTOK_VIDEO_ALLOWED_HOSTS=

# ─── Stockage durable des jetons (Direct Post + hub d'intégrations) ────────────────────
# Ajoutez « Upstash Redis » au projet (Vercel → Storage → Marketplace) : ces variables sont alors
# injectées automatiquement. À renseigner à la main uniquement pour un test local avec une vraie base.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Anciens noms « Vercel KV », également reconnus : KV_REST_API_URL / KV_REST_API_TOKEN

# ─── Hub d'intégrations : Meta (Facebook Pages + Instagram) ────────────────────────────
META_APP_ID=
META_APP_SECRET=
# URI de retour, à déclarer à l'identique dans le dashboard Meta.
META_REDIRECT_URI=https://yallahservices.vercel.app/api/integrations/meta/auth/callback
# Scopes (virgules). Par défaut : pages_show_list,pages_manage_posts,pages_read_engagement,
# instagram_basic,instagram_content_publish
META_SCOPE=
# Version du Graph API. Par défaut : v23.0
META_API_VERSION=
# Clé de signature des webhooks Meta (X-Hub-Signature-256). Par défaut : l'app secret.
META_WEBHOOK_SECRET=
# Jeton de vérification du dashboard Meta (hub.verify_token). Optionnel, recommandé.
META_WEBHOOK_VERIFY_TOKEN=

# ─── Hub d'intégrations : LinkedIn ─────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# URI de retour, à déclarer à l'identique dans LinkedIn for Developers.
LINKEDIN_REDIRECT_URI=https://yallahservices.vercel.app/api/integrations/linkedin/auth/callback
# Scopes (espaces). Par défaut : w_member_social w_organization_social r_liteprofile
LINKEDIN_SCOPE=
# Identifiant numérique de la Company Page (sinon fourni à chaque publication).
LINKEDIN_ORGANIZATION_ID=

# ─── Hub d'intégrations : TikTok ───────────────────────────────────────────────────────
# Identifiants propres au hub (optionnel). Par défaut : TIKTOK_ADMIN_* puis TIKTOK_*.
TIKTOK_INTEGRATION_CLIENT_KEY=
TIKTOK_INTEGRATION_CLIENT_SECRET=
# URI de retour DU HUB (à déclarer chez TikTok, distincte des produits 1 et 2).
# Par défaut : domaine des autres URIs TikTok + /api/integrations/tiktok/auth/callback.
TIKTOK_INTEGRATION_REDIRECT_URI=https://yallahservices.vercel.app/api/integrations/tiktok/auth/callback
# Clé HMAC des webhooks TikTok (Content Posting API). Par défaut : le client_secret du hub.
TIKTOK_WEBHOOK_SECRET=

# ─── Opérations système ────────────────────────────────────────────────────────────────
# Secret de la tâche planifiée de rafraîchissement des jetons
# (GET/POST /api/admin/system/cron/refresh-tokens, en-tête x-cron-secret ou Bearer).
# 24 caractères minimum (openssl rand -hex 32). Absent : l'endpoint est désactivé (503).
CRON_SECRET=

# ─── Divers ────────────────────────────────────────────────────────────────────────────
# Adresse publique (canonique, partages, publication TikTok). Par défaut : le domaine Vercel de production.
NEXT_PUBLIC_SITE_URL=https://yallahservices.vercel.app
